# Application
APP_NAME=TripWise API
ENVIRONMENT=development
DEBUG=true
AUTO_CREATE_TABLES=true
AUTO_SEED_REFERENCE_DATA=true

# Database
# MySQL 8.0+ example:
# DATABASE_URL=mysql+pymysql://tripwise_user:change-me@127.0.0.1:3306/tripwise
DATABASE_URL=sqlite:///./tripwise.db

# JWT - replace this value outside local development
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
