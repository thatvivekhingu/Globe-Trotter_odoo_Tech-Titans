# Application
APP_NAME=TripWise API
ENVIRONMENT=development
DEBUG=true
AUTO_CREATE_TABLES=true
AUTO_SEED_REFERENCE_DATA=true

# Database Configuration
# 1. Enterprise PostgreSQL (Supabase / Neon / AWS RDS / GCP Cloud SQL) - RECOMMENDED FOR PRODUCTION:
# DATABASE_URL=postgresql+psycopg2://postgres:your_password@db.xxxx.supabase.co:5432/postgres
# 2. Enterprise MySQL 8.0+ / MariaDB (Odoo ERP Standard):
# DATABASE_URL=mysql+pymysql://tripwise_user:your_password@127.0.0.1:3306/tripwise
# 3. SQLite (Local dev default):
DATABASE_URL=sqlite:///./tripwise.db


# JWT - replace this value outside local development
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI generation (kept server-side; never expose keys in the frontend)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=your_gemini_api_key_here
